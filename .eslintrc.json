{
  "root": true,
  "env": { "browser": true, "es2021": true },
  "parserOptions": { "ecmaVersion": 2021, "sourceType": "script" },
  "extends": "eslint:recommended",
  "rules": {
    "quotes": ["error", "double", { "avoidEscape": true }],
    "semi": ["error", "always"],
    "space-before-function-paren": ["error", { "anonymous": "always", "named": "never", "asyncArrow": "always" }]
  },
  "globals": {
    "buildLogo": "readonly",
    "buildMenu": "readonly",
    "buildSidebar": "readonly",
    "buildFooter": "readonly",
    "createState": "readonly",
    "loadTranslations": "readonly",
    "ALBUM_PROMO_TRANSLATIONS": "readonly",
    "createIconLink": "readonly",
    "LANG_STORAGE_KEY": "readonly",
    "THEME_STORAGE_KEY": "readonly",
    "React": "readonly",
    "ReactDOM": "readonly"
  }
}
